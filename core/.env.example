# Any LiteLLM model string works (e.g. gemini/gemini-3.5-flash, gpt-4o-mini)
LLM_MODEL="gemini/gemini-3.5-flash"
# Optional stronger model for the Research Manager + Portfolio Manager (defaults to LLM_MODEL)
# LLM_DEEP_MODEL="gemini/gemini-3.1-pro-preview"

GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Reddit is rate-limited and slow, off by default
# ENABLE_REDDIT=1
LLM_REASONING="low"

# Free tier = ~20 requests/day PER MODEL. A run costs 8 + 2*DEBATE_ROUNDS calls.
# Spread them: cheap model for most agents, stronger one for the 2 manager calls.
# LLM_MODEL="gemini/gemini-3.1-flash-lite"
# LLM_DEEP_MODEL="gemini/gemini-3.5-flash"
# DEBATE_ROUNDS=1

# Paper trading (Alpaca paper account keys, never live keys)
# ALPACA_API_KEY="..."
# ALPACA_SECRET_KEY="..."

# Free tier allows only ~5 requests/minute; this throttles all LLM calls (0 = unlimited)
# LLM_RPM=5

# Groq free tier (per model: 30 RPM, 8K tokens/min, 1K requests/day, 200K tokens/day; one analysis ~57K tokens).
# GROQ_API_KEY="..."
# LLM_MODEL="groq/openai/gpt-oss-20b"
# LLM_DEEP_MODEL="groq/openai/gpt-oss-120b"
# LLM_RPM=25
# LLM_TPM=7000   # per-minute token budget per model; calls to one model run one at a time when set

# Observability (metrics stack: cd ../observability && docker compose up -d; see ../observability/README.md)
# Traces to Langfuse Cloud (free tier); leave unset to disable tracing. Metrics at /metrics are always on.
# LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"   # or https://cloud.langfuse.com (EU); LANGFUSE_HOST also works
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# TRACE_CONTENT=0          # 0 = do not send prompts/replies to Langfuse
# ENABLE_SCHEDULER=1       # run the weekday 16:30 ET daily cycle inside the API process (dry run unless SCHEDULER_EXECUTE=1)
# SCHEDULER_EXECUTE=0


# --- simulated paper account + automation ---
# PORTFOLIO_MODE=sim (default, persistent, supports admin deposits) | alpaca (needs ALPACA_* paper keys)
PORTFOLIO_MODE=sim
# SIM_START_CASH=100000
DEBATE_ROUNDS=2            # bull/bear rounds per analysis (each round = 2 LLM calls)
ENABLE_SCHEDULER=1         # daily cycle: DAILY_DAYS (default mon-fri) at DAILY_AT (default 16:30) New York time
SCHEDULER_EXECUTE=1        # the cycle trades the simulated account; 0 = dry runs only
# DAILY_AT=16:30
# DAILY_LOCK_MINUTES=60    # visitors cannot queue analyses this long before the daily cycle, nor while it runs
DAILY_CANDIDATES=3         # new watchlist stocks analysed per cycle
HELD_REVIEW_DAYS=7         # a held stock is re-analysed at most this often (stops cover the gap)
DAILY_HELD_MAX=4           # held stocks re-analysed per cycle, oldest review first
QUEUE_MAX=3                # visitors can queue this many analyses at once
ADMIN_PASSWORD=change-me   # /admin (not linked from the UI); empty disables it
# STATE_DIR=/app/state     # where decisions, trades, analyses and the account live (a Docker volume on the server)
